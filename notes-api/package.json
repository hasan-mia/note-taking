{
  "name": "notes-api",
  "version": "1.0.0",
  "description": "Secure Note-Taking REST API with Express, MongoDB, JWT auth",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed:admin": "node src/seeds/seedAdmin.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop notes-api",
    "pm2:logs": "pm2 logs notes-api"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "notes"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pm2": "^7.0.4"
  }
}
